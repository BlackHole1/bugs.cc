---
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';
import SunMoon from '@lucide/astro/icons/sun-moon';
import { useTranslations, type Lang } from '@/i18n';
import { SITE } from '@/lib/site';

/**
 * Theme switch in the nav with three states, `auto` (the default: follow
 * the OS), `light` and `dark`. The button shows the icon of the current
 * state (Lucide `sun-moon`, the icon its library tags "system theme", then
 * sun, moon), turning from one to the next in CSS, and its accessible name
 * says what the next press does. The choice is stored in
 * `localStorage.theme` as `light` or `dark`, and removed for `auto`; the
 * inline script in Base.astro reads it before first paint and sets
 * `data-theme` on `<html>`, `auto` when nothing valid is stored. Without
 * JavaScript the button is hidden (global.css:
 * `:root:not([data-theme]) .theme-toggle`) and the page follows the OS
 * through `color-scheme: light dark`.
 *
 * Order of the cycle, relative to the OS scheme so that the first press
 * always changes the page: `auto` -> the scheme the OS is not showing ->
 * the OS scheme -> `auto`. On a dark OS that is auto, light, dark, auto; on
 * a light one auto, dark, light, auto.
 *
 * The script below (inlined by Astro) does the rest: pressing the button
 * advances the state, stores it and updates the attribute, the name and
 * `theme-color`, inside a view transition that wipes the new page down over
 * the old one (global.css, `data-theme-switch`); a change of the OS scheme
 * is followed (`theme-color` and
 * the name depend on it); another tab's choice is picked up through the
 * `storage` event; a page shown from the back/forward cache or the
 * Speculation Rules prerender (which ran the head script earlier, possibly
 * with a stale value) re-reads the stored theme.
 */
export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  class="nav-link theme-toggle"
  data-theme-toggle
  data-label-auto={t.nav.themeAuto}
  data-label-light={t.nav.themeLight}
  data-label-dark={t.nav.themeDark}
  data-color-light={SITE.themeColor.light}
  data-color-dark={SITE.themeColor.dark}
  aria-label={t.nav.themeDark}
>
  <!-- The three icons share one grid cell; global.css fades and turns them (`.theme-toggle-icons`). -->
  <span class="theme-toggle-icons" aria-hidden="true">
    <SunMoon class="nav-icon theme-toggle-auto" size={16} focusable="false" />
    <Sun class="nav-icon theme-toggle-sun" size={16} focusable="false" />
    <Moon class="nav-icon theme-toggle-moon" size={16} focusable="false" />
  </span>
</button>

<script>
  type Scheme = 'light' | 'dark';
  type Theme = 'auto' | Scheme;

  const isScheme = (value: unknown): value is Scheme => value === 'light' || value === 'dark';

  /** The stored choice; `auto` when there is none or storage is unavailable. */
  const stored = (): Theme => {
    try {
      const value = localStorage.getItem('theme');
      return isScheme(value) ? value : 'auto';
    } catch {
      return 'auto';
    }
  };
  const store = (theme: Theme) => {
    try {
      if (theme === 'auto') localStorage.removeItem('theme');
      else localStorage.setItem('theme', theme);
    } catch {
      // Private mode with storage disabled: the choice lasts for this page.
    }
  };

  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (button) {
    const root = document.documentElement;
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    const media = matchMedia('(prefers-color-scheme: dark)');

    const os = (): Scheme => (media.matches ? 'dark' : 'light');
    /** The state on the page now (kept even when storage is disabled). */
    const current = (): Theme => (isScheme(root.dataset.theme) ? root.dataset.theme : 'auto');
    /** auto -> the scheme the OS is not showing -> the OS scheme -> auto. */
    const next = (theme: Theme): Theme => {
      if (theme === 'auto') return os() === 'dark' ? 'light' : 'dark';
      return theme === os() ? 'auto' : os();
    };
    const label = (theme: Theme) => {
      const { labelAuto, labelLight, labelDark } = button.dataset;
      return (theme === 'auto' ? labelAuto : theme === 'dark' ? labelDark : labelLight) ?? '';
    };

    const apply = (theme: Theme) => {
      root.dataset.theme = theme;
      // The name says what the next press does.
      button.setAttribute('aria-label', label(next(theme)));
      if (meta) {
        const scheme = theme === 'auto' ? os() : theme;
        meta.content =
          (scheme === 'dark' ? button.dataset.colorDark : button.dataset.colorLight) ?? '';
      }
    };
    const sync = () => apply(stored());

    /**
     * A press changes the page inside a view transition (the wipe in
     * global.css, keyed on `data-theme-switch`); the other ways the theme
     * changes (OS, another tab, a restored page) apply at once. Without the
     * API, or with reduced motion, the press applies at once as well.
     */
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    button.addEventListener('click', () => {
      const theme = next(current());
      store(theme);
      if (!document.startViewTransition || reducedMotion.matches) {
        apply(theme);
        return;
      }
      root.dataset.themeSwitch = '';
      const transition = document.startViewTransition(() => apply(theme));
      transition.finished.finally(() => {
        delete root.dataset.themeSwitch;
      });
    });
    // The OS scheme decides the page while `auto` and the order of the cycle
    // (so the name) always; re-apply the state the page has.
    media.addEventListener('change', () => apply(current()));
    window.addEventListener('storage', (event) => {
      if (event.key === null || event.key === 'theme') sync();
    });
    document.addEventListener('prerenderingchange', sync);
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) sync();
    });
    sync();
  }
</script>
