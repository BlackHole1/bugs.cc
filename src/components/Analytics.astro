---
/**
 * Umami page-view analytics, loaded so that an unreachable `cloud.umami.is`
 * can never affect the page.
 *
 * The old `<script defer src=...>` in `<head>` sat in the document's ordered
 * "execute after parsing" list together with every inlined `type="module"`
 * script (table of contents highlighting, Lightbox, Expressive Code's own
 * script (scrollable-block tabindex); the `is:inline` classic scripts such as
 * the home page clock run
 * during parsing and were never affected): the browser runs that list in
 * document order and waits for each entry to be ready, so while the Umami
 * download hung (a proxy that black-holes the host) none of the later module
 * scripts ran, and `DOMContentLoaded` / `load` waited too: 17 to 55 s of
 * "loading" per page on such a network, then a connection error.
 *
 * This component instead ships a tiny inline loader that waits for the
 * window `load` event (and an idle slot via `requestIdleCallback` where
 * available), then appends `<script async src=... data-website-id=...>`.
 * Nothing in the page depends on it: rendering, the load event and the
 * in-page scripts are exactly as if there were no analytics at all, and a
 * hanging request only delays the page-view beacon. The script itself is
 * unchanged (same src and website id, `SITE.umami`); no preconnect, no
 * Do-Not-Track handling, same behaviour as before otherwise.
 *
 * Never load it with a static `<script src>` (or a preconnect); redirect
 * pages carry no analytics at all.
 */
import { SITE } from '@/lib/site';

const src = JSON.stringify(SITE.umami.src);
const websiteId = JSON.stringify(SITE.umami.websiteId);

// Kept as a plain string (not `define:vars`) so the values stay inside the
// IIFE instead of becoming globals, and `is:inline` leaves it byte-for-byte.
const loader = `(function(){var inject=function(){var s=document.createElement('script');s.async=true;s.src=${src};s.setAttribute('data-website-id',${websiteId});document.head.appendChild(s)};var idle=function(){'requestIdleCallback'in window?requestIdleCallback(inject,{timeout:3000}):setTimeout(inject,0)};document.readyState==='complete'?idle():addEventListener('load',idle,{once:true})})();`;
---

<script is:inline data-analytics="umami" set:html={loader} />
