---
/**
 * Flat `date  title` list of posts, one row each, like the old site.
 * Reusable on the posts list, tag pages and the home page.
 */
import { useTranslations, type Lang } from '@/i18n';
import { formatDate, toIsoWithOffset } from '@/lib/dates';
import { pathOf, type Post } from '@/lib/posts';

export interface Props {
  posts: Post[];
  lang: Lang;
  /** Optional id of the heading that names this list (`aria-labelledby`). */
  labelledBy?: string | undefined;
  /** Prefetch strategy of the post links (default: the site-wide hover). */
  prefetch?: 'viewport' | undefined;
}

const { posts, lang, labelledBy, prefetch } = Astro.props;
// The list may sit on a page of the other language (home page bio): tag it
// with the posts' BCP 47 tag (`en` / `zh-Hans`), not the internal code.
const t = useTranslations(lang);
---

<ul class="post-list" lang={t.htmlLang} aria-labelledby={labelledBy}>
  {posts.map((post) => (
    <li>
      <time datetime={toIsoWithOffset(post.data.date)}>{formatDate(post.data.date)}</time>
      <a href={pathOf(post)} data-astro-prefetch={prefetch}>
        {post.data.title}
      </a>
    </li>
  ))}
</ul>

<style>
  /*
   * Rows of `date  title`. The whole row is the target (the link's
   * `::after` covers it: no dead zones between rows, "Web 流畅界面建议");
   * hovering anywhere on it sweeps the title's underline in. The row bleeds
   * into its padding so the dates line up with the text column and the
   * focus ring has room.
   */
  .post-list {
    list-style: none;
    padding: 0;
    /* Never wider than the gutter (text-only zoom grows the rem). */
    margin: 0 calc(-1 * min(0.75rem, var(--gutter))) 1.5rem;
  }

  .post-list li {
    position: relative;
    display: flex;
    gap: 1em;
    align-items: baseline;
    margin: 0;
    padding: 0.55em 0.75rem;
  }

  .post-list time {
    flex: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .post-list a {
    color: var(--heading);
    -webkit-tap-highlight-color: transparent;
  }

  .post-list a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sm);
  }

  .post-list a:visited {
    color: var(--muted);
  }

  .post-list a:focus-visible {
    outline: none;
  }

  .post-list a:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 0;
  }
</style>
