{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build --force",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "oxlint --deny-warnings && markdownlint-cli2",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "fmt": "oxfmt && prettier --write \"src/**/*.astro\"",
    "fmt:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "og": "bun scripts/og-image.ts",
    "favicon": "bun scripts/favicon.ts",
    "font": "bun scripts/subset-font.ts",
    "img": "bun scripts/img.ts",
    "lh": "bun scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@lucide/astro": "^1.34.0",
    "astro": "^7.2.6",
    "astro-expressive-code": "^0.44.1",
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.2",
    "satteri": "^0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/hast": "^3.0.4",
    "@types/node": "^26.3.0",
    "lighthouse": "13.4.1",
    "markdownlint-cli2": "^0.23.2",
    "node-html-parser": "^9.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "subset-font": "2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
