{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build --force && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "vp lint --deny-warnings && markdownlint-cli2",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "og": "vpx scripts/og-image.ts",
    "favicon": "vpx scripts/favicon.ts",
    "font": "vpx scripts/subset-font.ts",
    "img": "vpx scripts/img.ts",
    "lh": "vpx scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@lucide/astro": "^1.34.0",
    "astro": "^7.2.6",
    "astro-expressive-code": "^0.44.1",
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.2",
    "satteri": "^0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.5.2",
    "@types/hast": "^3.0.4",
    "@types/node": "^26.3.0",
    "lighthouse": "13.4.1",
    "markdownlint-cli2": "^0.23.2",
    "node-html-parser": "^9.0.1",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.3",
    "subset-font": "2.5.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
